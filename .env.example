# Telegram: create a bot with @BotFather, paste the token, start the bot, send /chatid to get your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Polling
POLL_INTERVAL=5
EXCHANGES=bybit,bitget

# Ads paying ONLY with these non-cash methods are ignored on every exchange (they trade at a premium,
# e.g. phone credit, and would otherwise show up as the "best" price). Comma-separated, case-insensitive.
EXCLUDED_PAY_METHODS=Airtime Mobile Top-Up,Mobile Top-Up,Airtime,Gift Card

# Binance: only shows MMK ads to Myanmar-KYC accounts, so it needs a read-only API key from one.
# Binance -> API Management -> Create API: enable ONLY "Enable Reading", restrict to this server's IP.
# When both are set, binance is added to EXCHANGES automatically.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Storage (raw 5s rows kept this many days, then rolled into hourly OHLC kept forever)
DB_PATH=data/p2ptracker.db
RAW_RETENTION_DAYS=30

# Dashboard basic auth — set both when the dashboard is reachable from the internet
DASHBOARD_USER=
DASHBOARD_PASS=

# Docker port binding: 127.0.0.1 = reachable only via SSH tunnel (default);
# 0.0.0.0 = open on http://<vps-ip>:PORT (requires DASHBOARD_USER/PASS above)
BIND_ADDR=127.0.0.1
PORT=8000

# HTTPS on 443 via Caddy (automatic Let's Encrypt). Point the domain's DNS A record at the VPS,
# then uncomment both lines and run: docker compose up -d
# COMPOSE_PROFILES=https
# DOMAIN=p2p.example.com

DISPLAY_TZ=Asia/Yangon

# Pattern agent: every minute, looks for sudden spikes/drops and one-way trend runs and posts
# them to TELEGRAM_CHAT_ID. Thresholds below are the defaults.
PATTERN_ENABLED=true
PATTERN_INTERVAL=60
PATTERN_SPIKE_PCT=0.4
PATTERN_SPIKE_Z=3.0
PATTERN_TREND_MINUTES=10
PATTERN_TREND_PCT=0.3
PATTERN_COOLDOWN_MIN=30
# Which rates the agent watches: BUY (what you pay for 1 USDT, default), SELL, or BUY,SELL
PATTERN_SIDES=BUY
# Optional: Claude writes a 2-3 sentence summary of each detection (console.anthropic.com -> API keys).
# Leave empty to send rule-based messages only.
ANTHROPIC_API_KEY=
# claude-opus-5-5 (default) or claude-haiku-5-5 (about 40x cheaper; fine for short summaries)
PATTERN_MODEL=claude-opus-5-5
# Summary language: burmese (default, Unicode Myanmar script), english, or any language name
PATTERN_SUMMARY_LANG=burmese
